# Enforce consistent line endings across platforms
* text=auto

# Shell scripts must use LF (GitHub Actions runs on Linux)
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Salesforce metadata
*.cls text eol=lf
*.trigger text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.cmp text eol=lf
*.page text eol=lf
*.component text eol=lf

# Binary files
*.png binary
*.jpg binary
*.gif binary
*.zip binary
*.jar binary
